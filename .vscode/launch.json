{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Update Ticker Universe",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/update_ticker_universe.py",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Update Ticker Universe (with seed file)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/update_ticker_universe.py",
            "args": [
                "--seed-file", "data/manual_ticker_export.csv"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Daily Screener",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/pipeline/run_daily.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Tests (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "tests"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        }
    ]
}
