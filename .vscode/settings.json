{
    // Point this at your venv. On Windows this is
    // "${workspaceFolder}\\venv\\Scripts\\python.exe" instead.
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
    "python.terminal.activateEnvironment": true,

    // Ruff handles both linting and formatting (install the "Ruff" VS Code
    // extension: charliermarsh.ruff). One tool, no Black/Flake8/isort conflicts.
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll": "explicit"
        }
    },

    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests"
    ],

    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,

    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true
    },

    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true
}
